{
  "manifest_version": 3,
  "name": "newSave: OpenLearning Academic PDF Exporter",
  "version": "1.0.0",
  "description": "Converts multi-page learning content and DOM elements into unified publication-ready academic PDFs.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "logos/newSave_16.png",
    "32": "logos/newSave_32.png",
    "48": "logos/newSave_48.png",
    "128": "logos/newSave_128.png"
  },
  "action": {
    "default_title": "Open newSave Queue",
    "default_icon": {
      "16": "logos/newSave_16.png",
      "32": "logos/newSave_32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ]
}
